# Sveriges Talare – Konfiguration
# Kopiera denna fil till .env och fyll i dina värden:
#   cp .env.example .env

# ── OBLIGATORISK ──────────────────────────────────────────────────────────────

# Slack Incoming Webhook URL
# Inställning:
#   1. Gå till https://api.slack.com/apps
#   2. Skapa ny app → "Incoming Webhooks" → Slå på → "Add New Webhook to Workspace"
#   3. Välj kanal → Kopiera URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/DITT/WEBHOOK/HÄR

# ── VALFRI: Google Custom Search ──────────────────────────────────────────────
# Ger fler leads via Google-sökning (100 sökningar/dag gratis).
# Lämna tomt för att bara använda JobTech API + RSS (fungerar ändå bra).
#
# Steg 1 – API-nyckel: https://console.cloud.google.com/apis/credentials
#           Aktivera "Custom Search API" i API-biblioteket
# Steg 2 – Sök-ID: https://programmablesearchengine.google.com/
#           Skapa en sökmotor, sätt "Sök hela webben" → kopiera Sök-ID
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ── VALFRI: RSS-flöden ────────────────────────────────────────────────────────
# Egna RSS-flöden att bevaka (kommaseparerade URL:er).
# Lämna tomt för att använda standardflöden (Mynewsdesk event/konferens).
RSS_FEED_URLS=

# ── VALFRI: Övriga inställningar ──────────────────────────────────────────────

# Sökväg till lokal DuckDB-databas (sparar sett leads för deduplicering)
DB_PATH=leads.duckdb

# Hur ofta systemet kör (i timmar). Standard: var 24:e timme.
SEARCH_INTERVAL_HOURS=24

# Lägsta poäng (0.0–1.0) för att ett lead ska skickas till Slack.
# 0.6 = 60 % relevant. Sänk till 0.4 för fler leads, höj till 0.8 för färre.
MIN_SCORE_THRESHOLD=0.6
